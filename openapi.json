{
  "components": {
    "responses": {
      "INVARIANT_BREACH_500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SentinelError"
            }
          }
        },
        "description": "Refusal to Lie â€” Internal invariant could not be upheld.",
        "x-sentinel-name": "Refusal to Lie",
        "x-truth-contract": {
          "codex_seal_created": false,
          "partial_effects_forbidden": true
        }
      },
      "MALFORMED_ENVELOPE_400": {
        "content": {
          "application/json": {
            "examples": {
              "brokenForm": {
                "value": {
                  "code": 400,
                  "details": {
                    "reason": "missing field: payload"
                  },
                  "error": "MALFORMED_ENVELOPE",
                  "message": "The request payload is not a canonical envelope.",
                  "name": "Broken Form",
                  "trace_id": "..."
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/SentinelError"
            }
          }
        },
        "description": "Broken Form â€” The request could not be interpreted as a canonical envelope.",
        "x-sentinel-name": "Broken Gate",
        "x-truth-contract": {
          "consent_recorded": false,
          "events_appended": false,
          "policy_evaluated": false
        }
      },
      "TEMPORAL_VIOLATION_409": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SentinelError"
            }
          }
        },
        "description": "Broken Time â€” Temporal integrity violated.",
        "x-sentinel-name": "Broken Time",
        "x-truth-contract": {
          "codex_seal_created": false,
          "effects_executed": false
        }
      },
      "UNPROVEN_IDENTITY_401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SentinelError"
            }
          }
        },
        "description": "Unspoken Name â€” Identity not cryptographically proven.",
        "x-sentinel-name": "Unspoken Name",
        "x-truth-contract": {
          "consent_recorded": false,
          "events_appended": false,
          "policy_evaluated": false
        }
      },
      "WITHHELD_AUTHORITY_403": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SentinelError"
            }
          }
        },
        "description": "Closed Gate â€” Authenticated but authority denied.",
        "x-sentinel-name": "Closed Gate",
        "x-truth-contract": {
          "consent_recorded": true,
          "effects_executed": false,
          "policy_evaluated": true
        }
      }
    },
    "schemas": {
      "CanonicalEnvelope": {
        "$id": "https://example.org/schemas/CanonicalEnvelope.json",
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "properties": {
          "actor_id": {
            "format": "uuid",
            "type": "string"
          },
          "key_id": {
            "format": "uuid",
            "type": "string"
          },
          "nonce": {
            "format": "uuid",
            "type": "string"
          },
          "payload": {
            "type": [
              "object",
              "string",
              "array",
              "number",
              "boolean",
              "null"
            ]
          },
          "signature": {
            "description": "Base64 or hex-encoded signature",
            "type": "string"
          },
          "timestamp_utc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "actor_id",
          "key_id",
          "nonce",
          "timestamp_utc",
          "payload",
          "signature"
        ],
        "title": "CanonicalEnvelope",
        "type": "object"
      },
      "SentinelError": {
        "properties": {
          "code": {
            "type": "integer"
          },
          "details": {
            "type": "object"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "EnvelopeAuth": {
        "bearerFormat": "CanonicalEnvelope",
        "description": "Canonical envelope required: server canonicalizes envelope and verifies signature.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
